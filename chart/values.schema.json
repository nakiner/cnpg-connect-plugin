{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "watchNamespace": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "observer": {
      "type": "object",
      "properties": {
        "pollInterval": {
          "type": "string",
          "minLength": 1
        },
        "ttl": {
          "type": "string",
          "minLength": 1
        },
        "probeTimeout": {
          "type": "string",
          "minLength": 1
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxConcurrentClusters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "kubeAPIQPS": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38
        },
        "kubeAPIBurst": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "application": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "maxConcurrentStreams": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "maxConnections": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "maxRPCs": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "maxWatches": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "initialRequestTimeout": {"type": "string", "minLength": 1}
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "loadBalancerSourceRanges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 21},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
    "podDisruptionBudget": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 1}}
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "discoveryFrom": {"type": "array", "items": {"type": "object"}},
        "monitoringFrom": {"type": "array", "items": {"type": "object"}},
        "operatorPodSelector": {"type": "object"},
        "databaseNamespaceSelector": {"type": "object"},
        "apiServerCIDRs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "apiServerPorts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "object",
          "properties": {
            "existingServerSecret": {
              "type": "string",
              "maxLength": 253
            },
            "existingClientSecret": {
              "type": "string",
              "maxLength": 253
            },
            "clientCASecret": {
              "type": "string",
              "maxLength": 253
            },
            "clientCAKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "application": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "maxLength": 253
            },
            "extraDnsNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "extraIPAddresses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "createIssuer": {
              "type": "boolean"
            },
            "duration": {
              "type": "string",
              "minLength": 1
            },
            "renewBefore": {
              "type": "string",
              "minLength": 1
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
